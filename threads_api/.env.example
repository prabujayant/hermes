# Meta Threads API Configuration
# Get these from https://developers.facebook.com

APP_ID=your_threads_app_id
APP_SECRET=your_threads_app_secret
THREADS_USER_ID=your_threads_user_id
ACCESS_TOKEN=

# Optional: redirect URI for OAuth flow (must be listed in your app settings)
# OAUTH_REDIRECT_URI=http://localhost:8080/callback

# Optional: OpenRouter for `analyze` and `write-thread` (free models).
# Get a key at https://openrouter.ai/keys — never commit it.
# OPENROUTER_API_KEY=sk-or-...
# Optional model override (default uses the openrouter/free router).
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_FALLBACKS=